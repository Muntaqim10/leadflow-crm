# Supabase Database Configuration
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI provider for email generation + analytics insights.
# Set ONE of the two keys below. GROQ_API_KEY takes precedence if both are set.

# Option A: Groq (free tier, fast Llama-family models)
# GROQ_API_KEY=your_groq_api_key_here
# Optional: override the default model (openai/gpt-oss-120b; see GROQ_DEFAULT_MODEL in src/lib/ai.ts)
# GROQ_MODEL=openai/gpt-oss-120b

# Option B: OpenRouter (many models behind one key, with automatic fallback)
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: override the default model (minimax/minimax-m3:free).
# Paid models require credits on the OpenRouter account or calls fail with a 402.
# OPENROUTER_MODEL=minimax/minimax-m3:free
# Optional: attribution shown on OpenRouter's dashboards
# OPENROUTER_SITE_URL=https://your-app.vercel.app
# OPENROUTER_SITE_NAME=LeadFlow

# App settings
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
NEXT_PUBLIC_APP_URL=http://localhost:3000
